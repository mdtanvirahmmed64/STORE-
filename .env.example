# ================================================
#  ShopBD environment settings
#  Copy this file to ".env" and change the values
# ================================================

# Production-এ অবশ্যই একটি লম্বা র‍্যান্ডম key দিন
SECRET_KEY=change-me-to-a-long-random-string

# লোকাল কম্পিউটারে True, সার্ভারে False
DEBUG=True

# SSL (https) চালুর আগে False রাখুন, SSL দেওয়ার পর True
HTTPS_ENABLED=True

# কমা দিয়ে ডোমেইন লিখুন: example.com,www.example.com
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ---------- Database ----------
# mysql অথবা sqlite (sqlite দিলে MySQL ছাড়াই দ্রুত টেস্ট করা যাবে)
DB_ENGINE=mysql
DB_NAME=shopbd_db
DB_USER=shopbd_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------- Email (অর্ডার কনফার্মেশন ইমেইলের জন্য) ----------
# খালি রাখলে ইমেইল শুধু টার্মিনালে প্রিন্ট হবে
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ShopBD <no-reply@example.com>

# ---------- Mobile app (optional) ----------
# অ্যাপের ক্যাশ রিফ্রেশ করতে সংখ্যাটা বাড়ান (1, 2, 3 ...)
APP_VERSION=1
# শুধু PWABuilder দিয়ে বানানো অ্যাপের জন্য (android/README.md দেখুন)
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
